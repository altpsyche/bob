# Built artifacts (reproduced by `bob build` / setup)
/bin/

# Bob memory database (personal data, never commit)
/data/

# Python venvs (reproduced from the per-tool requirements files)
/tools/venv-webui/
/tools/venv-aider/
/tools/venv-litellm/
/tools/venv-eval/

# Pinned cmake fetched by osenv.linux_cmake3 when the distro cmake is outside osenv.CMAKE_RANGE (rolling distros)
/tools/cmake-*/

# Open WebUI runtime state (db, uploads, secret key)
/tools/webui-data/
.webui_secret_key

# Models (multi-GB, reproduced by `bob fetch` from config/models.json)
/models/*.gguf
/models/*.part
/models/.hf-cache/
/models/whisper/
/models/faster-whisper/

# Voice assets (reproduced by `bob setup-voice`)
/bin/voices/
/bin/espeak-ng-data/

# Generated runtime config — all of it regenerated from config/models.json by `bob gen`
# (scripts/tools/generate.py)
/config/llama-swap.yaml
/config/litellm.yaml
/config/continue/config.yaml
/config/dsh/
/config/aider/

# llama.cpp build dir (inside submodule; not tracked by parent anyway)
/external/llama.cpp/build/

# User-local config overrides (gitignored so git pull never clobbers tuning)
/config/user.json
/config/user.toml

# Service data volumes and the generated compose env (reproduced by `bob services <name> start`)
/tools/langfuse-data/
/tools/n8n-data/
/tools/searxng-data/
/tools/compose/.env

# Benchmark results (reproduced by llm eval)
/results/

# Python bytecode cache (generated by the agent/tools scripts)
__pycache__/
*.pyc
*.pyo

# misc
*.log
/logs/
/models/manifest.json
