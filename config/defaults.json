{
  "_comment": "The single neutral source of truth for shared constants. Read by Python (json.load in scripts/bob_core.py); it exists before the venv so bootstrap can use it. Never re-inline a port number or role literal elsewhere. 'ports' + 'roleTable' are the shared constants; 'runtime' is the neutral runtime-config default layer the Python resolver (scripts/bob_config.py) merges. Per-machine overrides live in config/user.json (deep-merged). This is the sole authoring source, read the same way on every OS.",

  "ports": {
    "port": 8080,
    "litellmPort": 8081,
    "sttPort": 8082,
    "ttsPort": 8083,
    "agentPort": 8084,
    "webuiPort": 3000,
    "langfusePort": 3001,
    "n8nPort": 5678,
    "searxngPort": 8888
  },

  "roleTable": {
    "chat":   { "base": "defaultRole", "pro": "proRole",      "fallback": "chat",    "proFallback": "chat-pro" },
    "voice":  { "base": "defaultRole", "pro": "proRole",      "fallback": "chat",    "proFallback": "chat-pro" },
    "code":   { "base": "codeRole",    "pro": "proCodeRole",  "fallback": "coder",   "proFallback": "coder-pro" },
    "think":  { "base": "thinkRole",   "pro": "proThinkRole", "fallback": "planner", "proFallback": "planner-pro" },
    "agent":  { "base": "agentRole",   "pro": "agentRole",    "fallback": "agent",   "proFallback": "agent" },
    "vision": { "section": "vision",   "base": "visionRole",  "pro": "visionProRole", "fallback": "vision", "proFallback": "vision-pro" }
  },

  "runtime": {
    "litellmKey": "sk-local",
    "persona": {
      "systemPrompt": "You are Bob, a helpful AI assistant. Be direct and honest, and if you don't know something, say so. When the user tells you durable facts about themselves — their name, role, or lasting preferences — save them with the memory_store tool (type 'profile' for identity, 'preference' for how they like you to work) so you remember them in future sessions. Don't re-store what you already know."
    },
    "memory": {
      "enabled": true,
      "autoRecall": false,
      "injectProfileAtStart": true,
      "profileMaxTokens": 200,
      "maxInjectedTokens": 1200,
      "dbPath": "data/bob.db",
      "embedModel": "embed",
      "recallK": 5,
      "recallThreshold": 0.35,
      "dedupThreshold": 0.92,
      "retrieval": "dense",
      "rrfK": 60,
      "rerank": false,
      "rerankTopN": 20,
      "rerankBaseUrl": "",
      "coreBlocks": {},
      "ranking": {
        "wSemantic": 1.0,
        "wRecency": 0.3,
        "wType": 0.2,
        "wUsage": 0.1,
        "wSalience": 0.3,
        "halfLifeDays": {"profile": 36500, "preference": 36500, "project": 90, "fact": 365, "episodic": 30}
      },
      "typeWeights": {"profile": 1.0, "preference": 0.9, "project": 0.8, "fact": 0.7, "episodic": 0.5},
      "maxSummaryTokens": 512,
      "autoSummarize": true,
      "autoConsolidate": true,
      "consolidateTimeout": 30,
      "reconcileTopK": 20,
      "maxRows": 2000,
      "forgetAfterDays": {"episodic": 180},
      "scopeByProject": true,
      "projectFiles": true,
      "bobMdMaxTokens": 4000
    },
    "vision": {
      "enabled": true,
      "visionRole": "vision",
      "visionProRole": "vision-pro"
    },
    "voice": {
      "enabled": true,
      "sttModel": "small",
      "ttsEngine": "piper",
      "ttsVoice": "en_GB-alan-medium",
      "silenceSec": 1.5,
      "maxTokens": 512
    },
    "agent": {
      "enabled": false,
      "agency": "show",
      "toolFormat": "hermes",
      "maxSteps": 10,
      "maxParallelTools": 1,
      "maxHistoryMsgs": 40,
      "maxContextTokens": 6000,
      "maxToolResultTokens": 1000,
      "compaction": "truncate",
      "compactKeepLastTurns": 6,
      "compactSummaryMaxTokens": 512,
      "compactSchemasAfter": 12,
      "stablePrefix": false,
      "clearToolResults": false,
      "clearToolResultsAfterTokens": 4000,
      "conversationPaging": false,
      "constrainedToolCalls": false,
      "subAgents": false,
      "maxAgentDepth": 2,
      "subAgentTools": [],
      "plan": false,
      "verify": false,
      "selfRepair": false,
      "recite": false,
      "todoTool": false,
      "requestTimeout": 600,
      "llmRetries": 2,
      "llmRetryBackoffSec": 2.0,
      "allowPrivateFetch": false,
      "autoStartSearxng": true,
      "disabledTools": [],
      "allowedReadPaths": [],
      "allowedWritePaths": [],
      "gitAllowedRoots": [],
      "agentPort": 8084,
      "serveHost": "127.0.0.1",
      "apiTokens": [],
      "defaultOwner": "local",
      "authStore": false,
      "defaultRatePerMin": 0,
      "sessionDbPath": "data/sessions.db",
      "maxSessionTokens": 0,
      "scheduleFile": "data/schedules.json",
      "logFile": "logs/bob-agent.log",
      "logMaxBytes": 5000000,
      "logBackupCount": 3,
      "maxResultChars": 500,
      "mcpEnabled": false,
      "mcpServers": {},
      "mcpTimeout": 30,
      "tracing": false,
      "otlpEndpoint": "",
      "permissions": {},
      "sandbox": "off",
      "sandboxLimits": {"cpuSeconds": 30, "memoryMB": 2048, "allowRoots": [], "network": false}
    }
  }
}
